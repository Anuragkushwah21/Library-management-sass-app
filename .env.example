# Copy to .env and fill in real values. NEVER commit .env.

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth
JWT_SECRET=<random 32+ char string, e.g. `openssl rand -base64 48`>
JWT_EXPIRY=7d
NEXTAUTH_SECRET=<random 32+ char string>
NEXTAUTH_URL=http://localhost:3000

# ===== Email =====
# Do providers support hain. EMAIL_PROVIDER se choose karo, ya khaali chhod do:
# SMTP_HOST set hai to smtp, warna resend.
EMAIL_PROVIDER=smtp

# From address — provider me verified sender hona chahiye
EMAIL_FROM=you@gmail.com

# --- Option A: SMTP relay (Brevo / Gmail) ---
# Domain kharidne ki zarurat nahi — sirf ek sender EMAIL verify karni hoti hai.
# Brevo : smtp-relay.brevo.com : 587  (SMTP key use karo, login password nahi)
# Gmail : smtp.gmail.com       : 587  (App Password chahiye, normal password nahi)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE optional — na do to port se decide hota hai (465 = true)

# --- Option B: Resend (https://resend.com/api-keys) ---
# Behtar deliverability, lekin real users ko bhejne ke liye verified DOMAIN
# chahiye. Bina domain ke `onboarding@resend.dev` sirf apne account wale email
# par hi deliver karta hai.
RESEND_API_KEY=

# Cloudinary
CLOUDINARY_CLINT_NAME=
CLOUDINARY_CLINT_API=
CLOUDINARY_CLINT_SECRET=

# App
NEXT_PUBLIC_APP_NAME=LibraSaaS
NEXT_PUBLIC_APP_URL=http://localhost:3000
LIBRARY_NAME=

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Cron
CRON_SECRET=<random string>

NODE_ENV=development
DEBUG=false
