# Copy to .env and fill in real values. NEVER commit .env.

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth
JWT_SECRET=<random 32+ char string, e.g. `openssl rand -base64 48`>
JWT_EXPIRY=7d
NEXTAUTH_SECRET=<random 32+ char string>
NEXTAUTH_URL=http://localhost:3000

# ===== Email =====
# Do providers support hain. EMAIL_PROVIDER se choose karo, ya khaali chhod do:
# SMTP_HOST set hai to smtp, warna resend.
EMAIL_PROVIDER=smtp

# From address — provider me verified sender hona chahiye
EMAIL_FROM=you@gmail.com

# --- Option A: SMTP relay (Brevo / Gmail) ---
# Domain kharidne ki zarurat nahi — sirf ek sender EMAIL verify karni hoti hai.
# Brevo : smtp-relay.brevo.com : 587  (SMTP key use karo, login password nahi)
# Gmail : smtp.gmail.com       : 587  (App Password chahiye, normal password nahi)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE optional — na do to port se decide hota hai (465 = true)

# --- Option B: Resend (https://resend.com/api-keys) ---
# Behtar deliverability, lekin real users ko bhejne ke liye verified DOMAIN
# chahiye. Bina domain ke `onboarding@resend.dev` sirf apne account wale email
# par hi deliver karta hai.
RESEND_API_KEY=

# Cloudinary
CLOUDINARY_CLINT_NAME=
CLOUDINARY_CLINT_API=
CLOUDINARY_CLINT_SECRET=

# App
NEXT_PUBLIC_APP_NAME=LibraSaaS
NEXT_PUBLIC_APP_URL=http://localhost:3000
LIBRARY_NAME=

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Cron
CRON_SECRET=<random string>

NODE_ENV=development
DEBUG=false

# =============================================================
# Student mobile OTP (QR check-in) — pick ONE provider
# =============================================================
# 1) Make an account with any provider below and get its API key
# 2) Set OTP_CHANNEL to that provider and fill in only its keys
# 3) Test: npx tsx --env-file=.env scripts/check-sms.ts --send 98XXXXXXXX
#
# OTP_CHANNEL options:
#   console  = no SMS; the code is printed in the server terminal (local dev only)
#   msg91    = MSG91        https://msg91.com       (India; needs a DLT-approved template)
#   fast2sms = Fast2SMS     https://www.fast2sms.com (India only; easiest to start)
#   2factor  = 2Factor.in   https://2factor.in      (India)
#   twilio   = Twilio       https://www.twilio.com  (any country)
#   webhook  = any other SMS service — describe its API with the OTP_WEBHOOK_* lines
# Leave it empty to auto-pick whichever provider has a key filled in.
OTP_CHANNEL=

# Text for twilio/webhook. Placeholders: {{code}} {{library}}
# (MSG91 / Fast2SMS / 2Factor send their own approved template instead.)
OTP_SMS_TEMPLATE=

# --- MSG91 (Flow API) ---
# Template must contain the variable named in MSG91_OTP_VAR, e.g. ##otp##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp

# --- Fast2SMS (Dev API → "OTP" route) ---
FAST2SMS_API_KEY=
# otp = OTP route (needs website verification in Fast2SMS "OTP Message" menu)
# q   = Quick SMS (needs one ₹100+ recharge; sends OTP_SMS_TEMPLATE text)
FAST2SMS_ROUTE=otp

# --- 2Factor.in ---
TWOFACTOR_API_KEY=
# Optional: template name from the 2Factor dashboard
TWOFACTOR_TEMPLATE=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Twilio phone number (+1...) or a Messaging Service SID (MG...)
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# --- Any other provider (webhook) ---
# Placeholders: {{phone}} (+9198..) {{phone_digits}} (9198..) {{phone_national}} (98..)
#               {{code}} {{message}} {{library}}
# Example:
#   OTP_WEBHOOK_URL=https://api.example.com/sms/send
#   OTP_WEBHOOK_HEADERS={"Authorization":"Bearer YOUR_KEY"}
#   OTP_WEBHOOK_BODY={"to":"{{phone_digits}}","text":"{{message}}"}
#   OTP_WEBHOOK_SUCCESS_TEXT=success
OTP_WEBHOOK_URL=
OTP_WEBHOOK_METHOD=POST
OTP_WEBHOOK_HEADERS=
OTP_WEBHOOK_BODY=
OTP_WEBHOOK_SUCCESS_TEXT=

# FREE TESTING: no SMS is sent and the code is shown on the student's screen.
# Works locally and on the deployed site. Turn OFF (false) before real students
# use the app — anyone could check in with any phone number while it's on.
OTP_TEST_MODE=false

# Production safety: true lets a deployed app print codes to the server log
# instead of texting them (without showing them on screen). Testing only.
ALLOW_CONSOLE_OTP=false
